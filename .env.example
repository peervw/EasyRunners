# Required for one-click GitHub App setup and secure cookies.
PUBLIC_URL=https://runners.example.com
ALLOW_INSECURE_PUBLIC_URL=false

# Server
MANAGER_HOST=0.0.0.0
MANAGER_PORT=8080
MANAGER_BIND_ADDRESS=127.0.0.1
LOG_LEVEL=INFO
CONFIG_PATH=/app/config.yaml
DATA_DIR=/data
INSTANCE_ID=primary
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12
# Set false for private/LAN polling-only installations.
WEBHOOK_ENABLED=true

# Repository migration scan limits. Each background pass keeps previous results
# visible and checks new or unverified repositories first.
ADOPTION_SCAN_INTERVAL=600
ADOPTION_RUNS_PER_REPO=5
ADOPTION_MAX_REPOSITORIES=100

# Optional operational failure notifications. EasyRunners POSTs signed JSON for
# stuck jobs, runner startup failures, and unhealthy GitHub connections.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_STUCK_JOB_SECONDS=900
NOTIFICATION_COOLDOWN_SECONDS=900

# GitHub auth: onboarding (recommended), app, or pat.
GITHUB_AUTH_MODE=onboarding
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Manual GitHub App fallback (leave empty when using dashboard onboarding).
GITHUB_SCOPE=repo
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# PAT development fallback. Do not use alongside App credentials.
GITHUB_TOKEN=

# Docker
DOCKER_HOST=unix:///var/run/docker.sock
RUNNER_NETWORK=easy-runners
RUNNER_IMAGE=
RUST_TOOLCHAIN=stable
RUNNER_VERSION=2.336.0
RUNNER_SHA256_X64=04cf0be1aff4c3ec3554466c39124ca250e3effd8873bb7e8d68535aa9505d5d
RUNNER_SHA256_ARM64=58b758e420b87093fbd4bfddd368074960053e2f1388f01848c82624b90f27d1

# Optional standard-pool overrides (legacy variable names are kept for compatibility)
RUNNER_MIN=
RUNNER_MAX=
RUNNER_LABELS=
RUNNER_CPU_LIMIT=
RUNNER_MEMORY_LIMIT=
RUNNER_JOB_TIMEOUT=
RUNNER_DOCKER_MODE=
